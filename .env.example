# URL canonica de produccion, sin slash final.
NEXT_PUBLIC_SITE_URL=

# Numero comercial real en formato internacional, solo digitos. Ejemplo Colombia: 57XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase. La publishable key puede usarse en browser; service role es solo servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mantener en "mock" hasta migrar productos, imagenes y variantes con paridad visual.
CATALOG_SOURCE=mock
