# URL pública HTTPS del ambiente, sin slash final (ej. https://lr7.vercel.app o tu dominio).
# Si falta, canonical/sitemap/robots usan VERCEL_PROJECT_PRODUCTION_URL (Vercel la define sola).
# Wompi también la usa como redirect-url del checkout (ver docs/wompi.md).
NEXT_PUBLIC_SITE_URL=

# Numero comercial real en formato internacional, solo digitos. Ejemplo Colombia: 57XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Alcance comercial (lib/store-scope.ts). Por defecto solo FUTBOL; Training y Streetwear quedan ocultos.
# Para activarlos: NEXT_PUBLIC_STORE_LINES=FUTBOL,TRAINING y NEXT_PUBLIC_STREETWEAR_ENABLED=true
NEXT_PUBLIC_STORE_LINES=
NEXT_PUBLIC_STREETWEAR_ENABLED=

# Perfiles oficiales (URL https completa). Vacío: no se muestra el enlace.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Medios de pago habilitados en producción, separados por coma: card,pse,nequi,bancolombia,addi.
# Todos se cobran a través de Wompi, Addi incluido (confirmado por el dueño, 2026-11-25): no requieren otra integración.
# Vacío: el pie muestra los marcadores temporales. Confirmar en el panel de Wompi qué medios están activos antes de rellenarlo.
NEXT_PUBLIC_PAYMENT_METHODS=

# Supabase. La publishable key puede usarse en browser; service role es solo servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mantener en "mock" hasta migrar productos, imagenes y variantes con paridad visual.
CATALOG_SOURCE=mock

# Vista local de solo lectura del panel, nunca activa en produccion.
ADMIN_PREVIEW=false

# Wompi. Configura llaves del mismo ambiente; secretos solo en variables server-side de Vercel.
# Mantener desactivado hasta aplicar la migración, configurar envío y completar aceptación Sandbox.
WOMPI_CHECKOUT_ENABLED=false
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox

# Secretos aleatorios independientes, mínimo 32 caracteres. No usar NEXT_PUBLIC_ ni reutilizar claves Wompi.
CHECKOUT_ACCESS_SECRET=
CRON_SECRET=
