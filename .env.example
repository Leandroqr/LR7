# URL canonica de produccion, sin slash final.
NEXT_PUBLIC_SITE_URL=https://www.futbolstreetwear.com

# Numero comercial real en formato internacional, solo digitos. Ejemplo Colombia: 57XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase. La publishable key puede usarse en browser; service role es solo servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mantener en "mock" hasta migrar productos, imagenes y variantes con paridad visual.
CATALOG_SOURCE=mock

# Vista local de solo lectura del panel, nunca activa en produccion.
ADMIN_PREVIEW=false

# Wompi. Configura llaves del mismo ambiente; secretos solo en variables server-side de Vercel.
# Mantener desactivado hasta aplicar la migración, configurar envío y completar aceptación Sandbox.
WOMPI_CHECKOUT_ENABLED=false
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox

# Secretos aleatorios independientes, mínimo 32 caracteres. No usar NEXT_PUBLIC_ ni reutilizar claves Wompi.
CHECKOUT_ACCESS_SECRET=
CRON_SECRET=
